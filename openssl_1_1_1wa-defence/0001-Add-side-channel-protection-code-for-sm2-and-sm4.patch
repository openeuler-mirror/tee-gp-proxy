From 40f6c63a493f0b03e2016542e0a69668a34b603f Mon Sep 17 00:00:00 2001
From: xiangchao-pub <xiangchao15@huawei.com>
Date: Tue, 14 Apr 2026 19:00:16 +0800
Subject: [PATCH] Add side channel protection code for sm2 and sm4

---
 crypto/sm2/sm2_crypt.c |  25 +++-
 crypto/sm2/sm2_sign.c  |   6 +-
 crypto/sm4/sm4.c       | 295 +++++++++++++++++++++++++++++++++++++++--
 3 files changed, 305 insertions(+), 21 deletions(-)

diff --git a/crypto/sm2/sm2_crypt.c b/crypto/sm2/sm2_crypt.c
index 83b97f4edc..d6b5a75fc5 100644
--- a/crypto/sm2/sm2_crypt.c
+++ b/crypto/sm2/sm2_crypt.c
@@ -260,10 +260,14 @@ int sm2_decrypt(const EC_KEY *key,
     int i;
     BN_CTX *ctx = NULL;
     const EC_GROUP *group = EC_KEY_get0_group(key);
+    const BIGNUM *order = EC_GROUP_get0_order(group);
     EC_POINT *C1 = NULL;
+    EC_POINT *R = NULL;
+    EC_POINT *C1_masked = NULL;
     struct SM2_Ciphertext_st *sm2_ctext = NULL;
     BIGNUM *x2 = NULL;
     BIGNUM *y2 = NULL;
+    BIGNUM *mask = NULL;
     uint8_t *x2y2 = NULL;
     uint8_t *computed_C3 = NULL;
     const size_t field_size = ec_field_size(group);
@@ -308,8 +312,9 @@ int sm2_decrypt(const EC_KEY *key,
     BN_CTX_start(ctx);
     x2 = BN_CTX_get(ctx);
     y2 = BN_CTX_get(ctx);
+    mask = BN_CTX_get(ctx);
 
-    if (y2 == NULL) {
+    if (y2 == NULL || mask == NULL) {
         SM2err(SM2_F_SM2_DECRYPT, ERR_R_BN_LIB);
         goto done;
     }
@@ -323,16 +328,22 @@ int sm2_decrypt(const EC_KEY *key,
         goto done;
     }
 
+    R = EC_POINT_new(group);
+    C1_masked = EC_POINT_new(group);
     C1 = EC_POINT_new(group);
-    if (C1 == NULL) {
+    if (C1 == NULL || R == NULL || C1_masked == NULL) {
         SM2err(SM2_F_SM2_DECRYPT, ERR_R_MALLOC_FAILURE);
         goto done;
     }
 
-    if (!EC_POINT_set_affine_coordinates(group, C1, sm2_ctext->C1x,
-                                         sm2_ctext->C1y, ctx)
-            || !EC_POINT_mul(group, C1, NULL, C1, EC_KEY_get0_private_key(key),
-                             ctx)
+    if (!EC_POINT_set_affine_coordinates(group, C1, sm2_ctext->C1x, sm2_ctext->C1y, ctx)
+            || !BN_priv_rand_range(mask, order)
+            || !EC_POINT_mul(group, R, mask, NULL, NULL, ctx)
+            || !EC_POINT_add(group, C1_masked, C1, R, ctx)
+            || !EC_POINT_mul(group, C1_masked, NULL, C1_masked, EC_KEY_get0_private_key(key), ctx)
+            || !EC_POINT_invert(group, R, ctx)
+            || !EC_POINT_mul(group, C1, NULL, R, EC_KEY_get0_private_key(key), ctx)
+            || !EC_POINT_add(group, C1, C1_masked, C1, ctx)
             || !EC_POINT_get_affine_coordinates(group, C1, x2, y2, ctx)) {
         SM2err(SM2_F_SM2_DECRYPT, ERR_R_EC_LIB);
         goto done;
@@ -380,6 +391,8 @@ int sm2_decrypt(const EC_KEY *key,
     OPENSSL_free(x2y2);
     OPENSSL_free(computed_C3);
     EC_POINT_free(C1);
+    EC_POINT_free(R);
+    EC_POINT_free(C1_masked);
     BN_CTX_free(ctx);
     SM2_Ciphertext_free(sm2_ctext);
     EVP_MD_CTX_free(hash);
diff --git a/crypto/sm2/sm2_sign.c b/crypto/sm2/sm2_sign.c
index 683f03f935..74489a8b65 100644
--- a/crypto/sm2/sm2_sign.c
+++ b/crypto/sm2/sm2_sign.c
@@ -254,9 +254,9 @@ static ECDSA_SIG *sm2_sig_gen(const EC_KEY *key, const BIGNUM *e)
 
         if (!BN_add(s, dA, BN_value_one())
                 || !ec_group_do_inverse_ord(group, s, s, ctx)
-                || !BN_mod_mul(tmp, dA, r, order, ctx)
-                || !BN_sub(tmp, k, tmp)
-                || !BN_mod_mul(s, s, tmp, order, ctx)) {
+                || !BN_mod_add(tmp, k, r, order, ctx)
+                || !BN_mod_mul(s, s, tmp, order, ctx)
+                || !BN_mod_sub(s, s, r, order, ctx)) {
             SM2err(SM2_F_SM2_SIG_GEN, ERR_R_BN_LIB);
             goto done;
         }
