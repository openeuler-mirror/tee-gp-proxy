From 7a7b23f4e449eb506a754e7cbae566ae3baf786f Mon Sep 17 00:00:00 2001
From: gongchangsui <gongchangsui@outlook.com>
Date: Sat, 13 Jun 2026 14:20:58 +0800
Subject: [PATCH 5/8] support get uid fromm vm

---
 Makefile               |  1 +
 core/gp_ops.c          | 15 ++++++++++++++-
 core/session_manager.c | 41 +++++++++++++++++++++++++++++++++++++++++
 tc_ns_client.h         |  3 +++
 4 files changed, 59 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 35e2abf..13dd419 100644
--- a/Makefile
+++ b/Makefile
@@ -60,6 +60,7 @@ EXTRA_CFLAGS += -DCONFIG_TEE_UPGRADE -DCONFIG_TEE_REBOOT -DCONFIG_CONFIDENTIAL_T
 EXTRA_CFLAGS += -I$(PWD)/tzdriver_internal/tee_reboot
 EXTRA_CFLAGS += -DMAILBOX_POOL_COUNT=32 -DLATE_KILL_WHEN_TA_LOAD
 EXTRA_CFLAGS += -DCONFIG_DISABLE_SHOW_AGENT_STATUS
+EXTRA_CFLAGS += -DVM_DEPLOY
 ifeq ($(CPU_BINDING), y)
 EXTRA_CFLAGS += -DCONFIG_CPU_BINDING -DCONFIG_NUM_TEE_DIE=4 -DCONFIG_NUM_TEE_PHY_CORE_PER_DIE=32
 endif
diff --git a/core/gp_ops.c b/core/gp_ops.c
index b9f6ab1..e6cc009 100644
--- a/core/gp_ops.c
+++ b/core/gp_ops.c
@@ -1448,7 +1448,20 @@ int tc_client_call(const struct tc_call_params *call_params)
 		return -ENOMEM;
 
 	op_params.smc_cmd->err_origin = TEEC_ORIGIN_COMMS;
-	op_params.smc_cmd->uid = get_uid_for_cmd();
+#ifdef VM_DEPLOY
+        tlogd("tzdriver-VM_DEPLOY yes\n");
+        if (call_params->dev->isVM) {
+            tlogd("tzdriver this call from vm\n");
+            op_params.smc_cmd->uid = call_params->context->vm_uid;
+        } else {
+            tlogd("tzdriver this call from host\n");
+            op_params.smc_cmd->uid = get_uid_for_cmd();
+        }
+#else
+        tlogd("tzdriver-VM_DEPLOY no\n");
+        op_params.smc_cmd->uid = get_uid_for_cmd();
+#endif
+	tlogd("tzdriver uid is %d\n", op_params.smc_cmd->uid);
 	if (call_params->context->param_types != 0) {
 		ret = alloc_operation(call_params, &op_params);
 		if (ret != 0)
diff --git a/core/session_manager.c b/core/session_manager.c
index 57e510a..5fc5abb 100644
--- a/core/session_manager.c
+++ b/core/session_manager.c
@@ -1201,6 +1201,42 @@ static int close_session(struct tc_ns_dev_file *dev,
 	return ret;
 }
 
+#ifdef VM_DEPLOY
+static int vm_close_session(struct tc_ns_dev_file *dev,
+	struct tc_ns_session *session, const unsigned char *uuid,
+	unsigned int uuid_len, unsigned int session_id, unsigned int vm_uid)
+{
+	struct tc_ns_client_context context;
+	int ret;
+	struct tc_call_params params = {
+		dev, &context, session, 0
+	};
+
+	if (uuid_len != UUID_LEN)
+		return -EINVAL;
+
+	if (memset_s(&context, sizeof(context), 0, sizeof(context)) != 0)
+		return -EFAULT;
+
+	if (memcpy_s(context.uuid, sizeof(context.uuid), uuid, uuid_len) != 0)
+		return -EFAULT;
+
+	context.session_id = session_id;
+	context.cmd_id = GLOBAL_CMD_ID_CLOSE_SESSION;
+	context.vm_uid = vm_uid;
+	params.flags = TC_CALL_GLOBAL | TC_CALL_SYNC;
+	ret = tc_client_call(&params);
+	if (ret != 0)
+		tloge("close session failed, ret=0x%x\n", ret);
+
+#ifdef CONFIG_REGISTER_SHAREDMEM
+	release_session_register_sharedmem(session);
+#endif
+	kill_ion_by_uuid((struct tc_uuid *)context.uuid);
+	return ret;
+}
+#endif
+
 static void close_session_in_service_list(struct tc_ns_dev_file *dev,
 	struct tc_ns_service *service)
 {
@@ -1337,8 +1373,13 @@ int tc_ns_close_session(struct tc_ns_dev_file *dev_file,
 	if (session) {
 		int ret2;
 		mutex_lock(&session->ta_session_lock);
+#ifdef VM_DEPLOY
+		ret2 = vm_close_session(dev_file, session, context->uuid,
+			(unsigned int)UUID_LEN, context->session_id, context->vm_uid);
+#else
 		ret2 = close_session(dev_file, session, context->uuid,
 			(unsigned int)UUID_LEN, context->session_id);
+#endif
 		mutex_unlock(&session->ta_session_lock);
 		if (ret2 != 0)
 			tloge("close session smc failed!\n");
diff --git a/tc_ns_client.h b/tc_ns_client.h
index cdad6d5..576dced 100644
--- a/tc_ns_client.h
+++ b/tc_ns_client.h
@@ -90,6 +90,9 @@ struct tc_ns_client_context {
 			uint32_t file_h_addr;
 		} memref;
 	};
+#ifdef VM_DEPLOY
+        __u32 vm_uid;
+#endif
 };
 
 struct tc_ns_client_time {
-- 
2.53.0

