diff --git a/rpm/SPECS/tzdriver.spec b/rpm/SPECS/tzdriver.spec
new file mode 100644
index 0000000..8656fdc
--- /dev/null
+++ b/rpm/SPECS/tzdriver.spec
@@ -0,0 +1,53 @@
+#Parameter
+%{!?KVERSION: %define KVERSION %(uname -r)}
+%define __strip /bin/true
+
+Name:           tzdriver
+Version:        1.0.0
+Release:        1%{?dist}
+Group:          System Environment/Kernel
+Summary:        itrustee driver
+License:        GPLv3
+
+%{?systemd_requires}
+BuildRequires: systemd
+
+%define kmodinstdir_prefix  /lib/modules/
+%{!?kernel:  %{expand: %%define kernel %%(uname -r)}}
+%description
+tzdriver is driver for tee
+
+%pre
+
+%install
+rm -rf $RPM_BUILD_ROOT
+mkdir -p %{buildroot}/%{_sysconfdir}/modprobe.d
+mkdir -p %{buildroot}%{kmodinstdir_prefix}%{kernel}/extra
+install -m 0640 %{_sourcedir}/%{name}-blacklist.conf %{buildroot}/%{_sysconfdir}/modprobe.d
+install -m 0550 %{_sourcedir}/%{name}.ko %{buildroot}%{kmodinstdir_prefix}%{kernel}/extra
+find $RPM_BUILD_ROOT -name '*.la' -exec rm -f {} ';'
+find %{buildroot} -type f -name \*.ko -exec %{__chmod} u+x \{\} \;
+
+%post
+if [[ %{KVERSION} != $(uname -r) ]]; then
+    if [ ! -d "/lib/modules/$(uname -r)/extra" ];then
+        mkdir -p /lib/modules/$(uname -r)/extra
+    fi
+
+    ln -sf /lib/modules/%{KVERSION}/extra/%{name}.ko /lib/modules/$(uname -r)/extra/%{name}.ko
+fi
+/sbin/depmod -a > /dev/null 2>&1
+
+%postun
+if [[ %{KVERSION} != $(uname -r) ]]; then
+    rm -rf /lib/modules/$(uname -r)/extra/%{name}.ko > /dev/null 2>&1
+fi
+/sbin/depmod -a > /dev/null 2>&1
+
+%files
+%{_sysconfdir}/modprobe.d/%{name}-blacklist.conf
+%{kmodinstdir_prefix}%{kernel}/extra/%{name}.ko
+
+%changelog
+* Mon Jul 20 2026 liuhao<liuhao365@h-partners.com>-1.0.0-1
+- package init
\ No newline at end of file
diff --git a/rpm/build_rpm.sh b/rpm/build_rpm.sh
new file mode 100644
index 0000000..d5dbfc0
--- /dev/null
+++ b/rpm/build_rpm.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+# Copyright (c) Huawei Technologies Co., Ltd. 2026-2026. All rights reserved.
+# build rpms for tzdriver
+set -eu
+
+RPM_CURDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
+RPMBUILD_PATH=${RPM_CURDIR}/rpmbuild
+SPECS_DIR=${RPM_CURDIR}/SPECS
+LIB_CODE_NAME=libboundscheck
+
+#step1: enter tzdriver source code and compile
+echo ${RPM_CURDIR}
+cd ${RPM_CURDIR}/..
+if [ ! -d "$LIB_CODE_NAME" ];then
+    git clone https://gitcode.com/openeuler/libboundscheck.git
+fi
+make clean
+make CPU_BINDING=y -j
+
+#step2: build_rpm
+mkdir -p ${RPMBUILD_PATH}/SOURCES
+cp -a ${RPM_CURDIR}/../tzdriver.ko ${RPMBUILD_PATH}/SOURCES/
+cp -a ${RPM_CURDIR}/conf/tzdriver-blacklist.conf ${RPMBUILD_PATH}/SOURCES/
+rpmbuild --define "_topdir ${RPMBUILD_PATH}" -bb ${SPECS_DIR}/tzdriver.spec
+
+#step3: clean_dir
+mkdir -p ${RPM_CURDIR}/output
+cp -a ${RPM_CURDIR}/rpmbuild/RPMS/aarch64/* ${RPM_CURDIR}/output
+[ -d "${RPM_CURDIR}/rpmbuild" ] && rm -rf ${RPM_CURDIR}/rpmbuild
+cd ${RPM_CURDIR}/..
+make clean
\ No newline at end of file
diff --git a/rpm/conf/tzdriver-blacklist.conf b/rpm/conf/tzdriver-blacklist.conf
new file mode 100644
index 0000000..df7750d
--- /dev/null
+++ b/rpm/conf/tzdriver-blacklist.conf
@@ -0,0 +1,3 @@
+# This kernel module can be automatically loaded by user when TEE function need to be use.
+# Remove the blacklist by adding a comment # at the start of the line.
+blacklist tzdriver
