index 0000000..afc3c8f
--- /dev/null
+++ b/rpm/build_rpm.sh
@@ -0,0 +1,51 @@
+#!/bin/bash
+# Copyright (c) Huawei Technologies Co., Ltd. 2026-2026. All rights reserved.
+# build rpms for itrustee client
+set -eu
+
+RPM_CURDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
+RPMBUILD_PATH=${RPM_CURDIR}/rpmbuild
+SPECS_DIR=${RPM_CURDIR}/SPECS
+LIB_CODE_NAME=libboundscheck
+
+function build_and_install_lib()
+{
+    local lib_code_name=$1
+    cd $RPM_CURDIR/../..
+    if [ ! -d "$lib_code_name" ];then
+        git clone https://gitcode.com/src-openeuler/$lib_code_name.git
+    fi
+    lib_path=$RPM_CURDIR/../../$lib_code_name
+    cd $lib_path
+    lib_rpmbuild_path=$lib_path/rpmbuild
+    mkdir -p ${lib_rpmbuild_path}/{BUILD,RPMS,SOURCES,SPECS,SRPMS}
+
+    cp *.spec ${lib_rpmbuild_path}/SPECS/
+    cp *.tar.gz ${lib_rpmbuild_path}/SOURCES/
+    rpmbuild --define "_topdir ${lib_rpmbuild_path}" -bb *.spec
+    rpm -Uvh $lib_rpmbuild_path/RPMS/aarch64/*.rpm
+    echo "$lib_code_name is installed."
+}
+
+#step1: enter itrustee client source code and compile
+echo ${RPM_CURDIR}
+if ! rpm -q $LIB_CODE_NAME &>/dev/null; then
+    build_and_install_lib $LIB_CODE_NAME
+fi
+
+cd ${RPM_CURDIR}/..
+make clean
+make -j
+
+#step2: build_rpm
+mkdir -p ${RPMBUILD_PATH}/SOURCES
+cp -a ${RPM_CURDIR}/../dist/* ${RPMBUILD_PATH}/SOURCES/
+cp -a ${RPM_CURDIR}/SOURCES/* ${RPMBUILD_PATH}/SOURCES/
+rpmbuild --define "_topdir ${RPMBUILD_PATH}" -bb ${SPECS_DIR}/tee_client.spec
+
+#step3: clean_dir
+mkdir -p ${RPM_CURDIR}/output
+cp -a ${RPM_CURDIR}/rpmbuild/RPMS/aarch64/* ${RPM_CURDIR}/output
+[ -d "${RPM_CURDIR}/rpmbuild" ] && rm -rf ${RPM_CURDIR}/rpmbuild
+cd ${RPM_CURDIR}/..
+make clean
\ No newline at end of file
