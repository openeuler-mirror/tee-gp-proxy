diff --git a/rpm/SOURCES/teecd.sh b/rpm/SOURCES/teecd.sh
new file mode 100644
index 0000000..d77c09b
--- /dev/null
+++ b/rpm/SOURCES/teecd.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# Copyright (c) Huawei Technologies Co., Ltd. 2026-2026. All rights reserved.
+# build rpms for itrustee client
+set -eu
+
+
+if [ $(systemd-detect-virt) = "none" ]; then
+    driver="tzdriver"
+else
+    driver="vtzdriver"
+fi
+
+/sbin/modprobe vhost_vsock || true
+
+if ! /sbin/modprobe "$driver" 2>/dev/null; then
+    echo "failed to load $driver"
+    exit 1
+fi
+
+exec /usr/bin/teecd
\ No newline at end of file
diff --git a/rpm/SPECS/tee_client.spec b/rpm/SPECS/tee_client.spec
new file mode 100644
index 0000000..59a9759
--- /dev/null
+++ b/rpm/SPECS/tee_client.spec
@@ -0,0 +1,58 @@
+Name:           tee_client
+Version:        1.0.0
+Release:        1%{?dist}
+Group:          System Environment/Daemons
+Summary:        itrustee daemon and libraries
+License:        GPLv3
+
+Provides: libteec.so()(64bit)
+
+%{?systemd_requires}
+BuildRequires: systemd
+
+%description
+teecd is daemon process for tee
+
+%pre
+
+%install
+rm -rf $RPM_BUILD_ROOT
+mkdir -p %{buildroot}%{_bindir}
+mkdir -p %{buildroot}%{_libdir}
+mkdir -p %{buildroot}%{_unitdir}
+install -m 0755 %{_sourcedir}/{teecd,tee_teleport,agentd,tlogcat,teecd.sh} %{buildroot}%{_bindir}/
+install -m 0644 %{_sourcedir}/libteec.so %{buildroot}%{_libdir}/
+install -m 0644 %{_sourcedir}/teecd.service %{buildroot}%{_unitdir}/
+
+%post
+/sbin/ldconfig
+systemctl daemon-reload || :
+systemctl enable teecd.service || :
+systemctl start teecd.service || :
+
+%preun
+if [ $1 -eq 0 ]; then
+    systemctl disable teecd.service || :
+    systemctl stop teecd.service || :
+fi
+
+%postun
+if [ $1 -eq 0 ]; then
+    systemctl daemon-reload || :
+fi
+
+%files
+%defattr(-,root,root,-)
+%{_bindir}/teecd
+%{_bindir}/tee_teleport
+%{_bindir}/agentd
+%{_bindir}/tlogcat
+%{_bindir}/teecd.sh
+
+%{_libdir}/libteec.so
+
+%{_unitdir}/teecd.service
+
+%changelog
+* Mon Jul 20 2026 liuhao<liuhao365@h-partners.com>-1.0.0-1
+- package init
\ No newline at end of file
diff --git a/rpm/build_rpm.sh b/rpm/build_rpm.sh
