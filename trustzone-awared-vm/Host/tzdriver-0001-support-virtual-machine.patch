+int fill_vm_shared_mem_info_block(uint64_t block_buf, uint32_t block_nums, uint32_t offset,
+	uint32_t buffer_size, uint64_t info_addr, uint32_t vm_page_size, pid_t vm_pid)
+{
+	struct page **host_pages = NULL;
+	uint64_t *phys_addr = NULL;
+	int host_page_num;
+	uint32_t block_page_total_no = 0;
+	struct task_struct *vmp_task;
+	uint32_t vm_pages_no = 0;
+	uint32_t host_pages_no = 0;
+	uint32_t host_offset = 0;
+	uint64_t vm_start_vaddr;
+	void *host_start_vaddr;
+	uint32_t page_total_no = 0;
+	uint32_t vm_pages_total_size = 0;
+	uint32_t litil_page_num;
+	uint64_t host_page_start_addr;
+
+	vmp_task = get_pid_task(find_get_pid(vm_pid), PIDTYPE_PID);
+	if (vmp_task == NULL) {
+		tloge("No task found for pid %d\n", vm_pid);
+		return -EFAULT;
+	}
+
+	uint32_t expect_page_num;
+	page_block_t *page_block;
+	expect_page_num = PAGE_ALIGN(buffer_size + (offset & (~PAGE_MASK))) / PAGE_SIZE;
+	page_block = (page_block_t *)(uintptr_t)block_buf;
+
+	uint32_t b_idx;
+	uint32_t p_idx;
+	uint32_t lp_idx;
+	for (b_idx = 0; b_idx < block_nums; b_idx++) {
+		vm_start_vaddr = page_block[b_idx].block.user_addr;
+		vm_pages_no = page_block[b_idx].block.page_num;
+
+		if (b_idx ==0 && vm_page_size > PAGE_SIZE) {
+			vm_start_vaddr += (offset & PAGE_MASK);
+			vm_pages_total_size = vm_pages_no * vm_page_size - (offset & PAGE_MASK);
+		} else {
+			vm_pages_total_size = vm_pages_no * vm_page_size;
+		}
+
+		host_offset = ((uint32_t)(uintptr_t)vm_start_vaddr) & (~PAGE_MASK);
+		host_start_vaddr = (void *)(((uint64_t)vm_start_vaddr) & PAGE_MASK);
+		host_pages_no = PAGE_ALIGN(host_offset + vm_pages_total_size) / PAGE_SIZE;
+		if (b_idx == block_nums -1 && vm_page_size > PAGE_SIZE)
+			host_pages_no = expect_page_num - page_total_no;
+
+		host_pages = (struct page **)vmalloc(host_pages_no * sizeof(uint64_t));
+		if (host_pages == NULL)
+			return -EFAULT;
+		tlogd("page_block[%u].block.user_addr = %llx, page_block[%u].block.page_num = %llx\n",
+			b_idx, vm_start_vaddr, b_idx, vm_pages_no);
+		host_page_num = pin_user_pages_remote_wrapper(vmp_task->mm, host_start_vaddr,
+						host_pages_no, host_pages);
+		
+		if (host_page_num <= 0) {
+			tloge("get_user_pages_remote failed, ret is %d\n", host_page_num);
+			vfree(host_pages);
+			return host_page_num == 0 ? -EFAULT : host_page_num;
+		}
+		if (host_page_num != host_pages_no) {
+			tloge("get pages failed, page_num = %d, expect %u\n", host_page_num, host_pages_no);
+			if (host_page_num > 0) {
+				release_pages(host_pages, host_page_num);
+			}
+			vfree(host_pages);
+			return -EFAULT;
+		}
+
+		phys_addr = (uint64_t *)(uintptr_t)info_addr + (sizeof(struct pagelist_info) / sizeof(uint64_t));
+		phys_addr = (uint64_t *)((char *)phys_addr +  page_total_no * sizeof(uint64_t));
+		block_page_total_no = 0;
+		for (p_idx = 0; p_idx < host_pages_no; p_idx++) {
+			struct page *page = NULL;
+			page = host_pages[p_idx];
+			if (page == NULL) {
+				release_pages(host_pages, host_page_num);
+				vfree(host_pages);
+				tloge("page == NULL \n");
+				return -EFAULT;
+			}
+			void *host_page_phy = (uintptr_t)page_to_phys(page);
+			if (vm_page_size <  PAGE_SIZE) {
+				if (p_idx !=0)
+					host_offset = 0;
+				litil_page_num = (PAGE_SIZE - host_offset) / vm_page_size;
+				host_page_start_addr = (uint64_t)host_page_phy + host_offset;
+				for (lp_idx = 0; lp_idx < litil_page_num && block_page_total_no < vm_pages_no;lp_idx++) {
+					phys_addr[block_page_total_no++] = host_page_start_addr + lp_idx * vm_page_size;
+				}
+			} else if (vm_page_size >=  PAGE_SIZE) {
+				phys_addr[p_idx] = (uintptr_t)page_to_phys(page);
+			}
+		}
+		page_total_no += (vm_page_size >= PAGE_SIZE ? host_pages_no : vm_pages_no);
+		vfree(host_pages);
+	}
+
+	struct pagelist_info *page_info;
+	page_info = (struct pagelist_info *)(uintptr_t)info_addr;
+	page_info->page_num = page_total_no;
+	page_info->page_size = (vm_page_size > PAGE_SIZE ? PAGE_SIZE : vm_page_size);
+	page_info->sharedmem_offset = offset & (~PAGE_MASK);
+	page_info->sharedmem_size = buffer_size;
+
+	return 0;
+}
