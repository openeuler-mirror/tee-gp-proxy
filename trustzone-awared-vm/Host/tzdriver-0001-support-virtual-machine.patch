+int read_from_vm_client(void *dest, size_t dest_size,
+	const void __user *src, size_t size, pid_t vm_pid)
+{
+	struct task_struct *vmp_task;
+	int rd_len;
+	int index;
+	int ret;
+
+	if (!dest || !src) {
+		tloge("src or dest is NULL input buffer\n");
+		return -EINVAL;
+	}
+
+	if (dest_size < size || !size) {
+		tloge("size is larger than dest_size or size is 0\n");
+		return -EINVAL;
+	}
+
+	vmp_task = get_pid_task(find_get_pid(vm_pid), PIDTYPE_PID);
+	if (vmp_task == NULL) {
+		tloge("no task for pid %d \n", vm_pid);
+		return  -EFAULT;
+	}
+
+	rd_len = access_process_vm(vmp_task,  (unsigned long)(src), dest, size, FOLL_FORCE);
+	if (rd_len != size) {
+		tloge("only read %d of %ld bytes by access_process_vm \n", rd_len, size);
+		put_task_struct(vmp_task);
+		return  -EFAULT;
+	}
+
+	put_task_struct(vmp_task);
+	return 0;
+}
+
+int write_to_vm_client(void __user *dest, size_t dest_size,
+	const void *src, size_t size, pid_t vm_pid)
+{
+	struct task_struct *vmp_task;
+	int wr_len;
+	int ret;
+
+	if (!dest || !src) {
+		tloge("src or dest is NULL input buffer\n");
+		return -EINVAL;
+	}
+
+	if (dest_size < size || !size) {
+		tloge("size is larger than dest_size or size is 0\n");
+		return -EINVAL;
+	}
+
+	vmp_task = get_pid_task(find_get_pid(vm_pid), PIDTYPE_PID);
+	if (vmp_task == NULL) {
+		tloge("no task for pid %d \n", vm_pid);
+		return  -EFAULT;
+	}
+
+	wr_len = access_process_vm(vmp_task,  (unsigned long)(dest), src, size, FOLL_FORCE | FOLL_WRITE);
+	if (wr_len != size) {
+		tloge("only write %d of %ld bytes by access_process_vm \n", wr_len, size);
+		put_task_struct(vmp_task);
+		return  -EFAULT;
+	}
+
+	put_task_struct(vmp_task);
+	return 0;
+}
