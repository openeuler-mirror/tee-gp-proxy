+static int pin_user_pages_remote_wrapper(struct mm_struct *mm,
+					 unsigned long start_addr,
+					 unsigned int nr_pages,
+					 struct page **pages)
+{
+	int ret;
+
+#if (KERNEL_VERSION(6, 5, 0) <= LINUX_VERSION_CODE)
+	ret = get_user_pages_remote(mm, start_addr, nr_pages,
+				    FOLL_FORCE, pages, NULL);
+#elif (KERNEL_VERSION(5, 9, 0) <= LINUX_VERSION_CODE)
+	ret = get_user_pages_remote(mm, start_addr, nr_pages,
+				    FOLL_FORCE, pages, NULL, NULL);
+#elif (KERNEL_VERSION(4, 10, 0) <= LINUX_VERSION_CODE)
+	ret = get_user_pages_remote(NULL, mm, start_addr, nr_pages,
+				    FOLL_FORCE, pages, NULL, NULL);
+#elif (KERNEL_VERSION(4, 9, 0) <= LINUX_VERSION_CODE)
+	ret = get_user_pages_remote(NULL, mm, start_addr, nr_pages,
+				    FOLL_FORCE, pages, NULL);
+#else
+	ret = get_user_pages_remote(NULL, mm, start_addr, nr_pages,
+				    1, 1, pages, NULL);
+#endif
+	return ret;
+}
