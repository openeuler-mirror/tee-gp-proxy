From 3eb41083bd297e05737eaaf55f104ac3d55ab53f Mon Sep 17 00:00:00 2001
From: liuhao365 <liuhao365@h-partners.com>
Date: Thu, 7 May 2026 16:36:28 +0800
Subject: [PATCH] vsock driver add translate cid and gpa interface

---
 trustzone-awared-vm/Host/vsock-4.19/vsock.c | 110 +++++++++++++++++++-
 1 file changed, 109 insertions(+), 1 deletion(-)

diff --git a/trustzone-awared-vm/Host/vsock-4.19/vsock.c b/trustzone-awared-vm/Host/vsock-4.19/vsock.c
index 7891bd4..2d59e17 100644
--- a/trustzone-awared-vm/Host/vsock-4.19/vsock.c
+++ b/trustzone-awared-vm/Host/vsock-4.19/vsock.c
@@ -16,6 +16,7 @@
 #include <linux/virtio_vsock.h>
 #include <linux/vhost.h>
 #include <linux/hashtable.h>
+#include <linux/interval_tree_generic.h>
 
 #include <net/af_vsock.h>
 #include "vhost.h"
@@ -38,6 +39,15 @@ enum {
 static DEFINE_SPINLOCK(vhost_vsock_lock);
 static DEFINE_READ_MOSTLY_HASHTABLE(vhost_vsock_hash, 8);
 
+static DEFINE_HASHTABLE(cid_pid_hash, 8);
+static DEFINE_MUTEX(cid_pid_mutex);
+
+struct vhost_vsock_cid_pid_map {
+	u32 cid;
+	u32 pid;
+	struct hlist_node node;
+};
+
 struct vhost_vsock {
 	struct vhost_dev dev;
 	struct vhost_virtqueue vqs[2];
@@ -54,6 +64,10 @@ struct vhost_vsock {
 	u32 guest_cid;
 };
 
+INTERVAL_TREE_DEFINE(struct vhost_umem_node,
+		     rb, __u64, __subtree_last,
+		     START, LAST, static inline, vhost_umem_interval_tree);
+
 static u32 vhost_transport_get_local_cid(void)
 {
 	return VHOST_VSOCK_DEFAULT_HOST_CID;
@@ -631,13 +645,54 @@ static void vhost_vsock_reset_orphans(struct sock *sk)
 	sk->sk_error_report(sk);
 }
 
+static void vhost_vsock_add_cid_pid(u32 cid, u32 pid)
+{
+	struct vhost_vsock_cid_pid_map *entry;
+
+	mutex_lock(&cid_pid_mutex);
+	hash_for_each_possible(cid_pid_hash, entry, node, cid) {
+		if (entry->cid == cid) {
+			entry->pid = pid;
+			goto unlock;
+		}
+	}
+
+	entry = kmalloc(sizeof(*entry), GFP_ATOMIC);
+	if (!entry)
+		goto unlock;
+
+	entry->cid = cid;
+	entry->pid = pid;
+	hash_add(cid_pid_hash, &entry->node, cid);
+
+unlock:
+	mutex_unlock(&cid_pid_mutex);
+}
+
+static void vhost_vsock_remote_cid_pid(u32 guest_cid)
+{
+	struct vhost_vsock_cid_pid_map *entry;
+	struct hlist_node *tmp;
+	mutex_lock(&cid_pid_mutex);
+	hash_for_each_possible_safe(cid_pid_hash, entry, tmp, node, guest_cid) {
+		if (entry->cid == guest_cid) {
+			hash_del(&entry->node);
+			kfree(entry);
+			break;
+		}
+	}
+	mutex_unlock(&cid_pid_mutex);
+}
+
 static int vhost_vsock_dev_release(struct inode *inode, struct file *file)
 {
 	struct vhost_vsock *vsock = file->private_data;
 
 	spin_lock_bh(&vhost_vsock_lock);
-	if (vsock->guest_cid)
+	if (vsock->guest_cid) {
 		hash_del_rcu(&vsock->hash);
+		vhost_vsock_remote_cid_pid(vsock->guest_cid);
+	}
 	spin_unlock_bh(&vhost_vsock_lock);
 
 	/* Wait for other CPUs to finish using vsock */
@@ -696,9 +751,62 @@ static int vhost_vsock_set_cid(struct vhost_vsock *vsock, u64 guest_cid)
 	hash_add_rcu(vhost_vsock_hash, &vsock->hash, vsock->guest_cid);
 	spin_unlock_bh(&vhost_vsock_lock);
 
+	vhost_vsock_add_cid_pid(guest_cid, current->tgid);
+
 	return 0;
 }
 
+u64 vhost_vsock_translate_gpa(u32 cid, u64 gpa, u64 size)
+{
+	struct vhost_vsock *vsock;
+	struct vhost_umem_node *node;
+	struct vhost_virtqueue *vq;
+	struct vhost_dev *dev;
+	struct vhost_umem *umem;
+	u64 hva = 0;
+
+	if (cid <= VMADDR_CID_HOST || size == 0)
+		return 0;
+
+	spin_lock_bh(&vhost_vsock_lock);
+	vsock = vhost_vsock_get(cid);
+	if (!vsock || !vsock->dev.umem)
+		goto out;
+
+	vq = &vsock->vqs[VSOCK_VQ_TX];
+	dev = vq->dev;
+	umem = dev->iotlb ? dev->iotlb : dev->umem;
+
+	node = vhost_umem_interval_tree_iter_first(&umem->umem_tree, gpa, gpa + size - 1);
+	if (!node || gpa < node->start || gpa > node->last)
+		goto out;
+
+	if (gpa + size > node->start + node->size)
+		goto out;
+	hva = node->userspace_addr + (gpa - node->start);
+out:
+	spin_unlock_bh(&vhost_vsock_lock);
+	return hva;
+}
+EXPORT_SYMBOL_GPL(vhost_vsock_translate_gpa);
+
+u32 vhost_vsock_translate_cid(u32 guest_cid)
+{
+	struct vhost_vsock_cid_pid_map *entry;
+	u32 pid = 0;
+
+	mutex_lock(&cid_pid_mutex);
+	hash_for_each_possible(cid_pid_hash, entry, node, guest_cid) {
+		if (entry->cid == guest_cid) {
+			pid = entry->pid;
+			break;
+		}
+	}
+	mutex_unlock(&cid_pid_mutex);
+	return pid;
+}
+EXPORT_SYMBOL_GPL(vhost_vsock_translate_cid);
+
 static int vhost_vsock_set_features(struct vhost_vsock *vsock, u64 features)
 {
 	struct vhost_virtqueue *vq;
-- 
